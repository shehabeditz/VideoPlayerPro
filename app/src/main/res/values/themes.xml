<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.VideoPlayerPro" parent="Theme.Material3.DayNight.NoActionBar">
    </style>

    <style name="Theme.VideoPlayerPro" parent="Base.Theme.VideoPlayerPro" />

    <!-- AMOLED: গাঢ় থিমের উপর খাঁটি কালো ব্যাকগ্রাউন্ড -->
    <style name="ThemeOverlay.VideoPlayerPro.Amoled" parent="">
        <item name="android:colorBackground">@color/black</item>
        <item name="colorSurface">@color/black</item>
        <item name="colorSurfaceContainer">@color/black</item>
        <item name="colorSurfaceContainerLow">@color/black</item>
        <item name="colorSurfaceContainerHigh">#121212</item>
        <item name="colorSurfaceVariant">#121212</item>
        <item name="colorSurfaceDim">@color/black</item>
        <item name="android:windowBackground">@color/black</item>
    </style>

    <!-- প্লেয়ার স্ক্রিন: সবসময় কালো, Material3 (Slider ইত্যাদি ডায়ালগের জন্য) -->
    <style name="Theme.VideoPlayerPro.Player" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
